# =============================================================================
# OxyQA — example environment config
# Copy to `.env` and fill in. Nothing is hardcoded in the app; every provider,
# URL, and key lives here. This is what lets the SAME codebase run as
# multi-tenant cloud SaaS and single-tenant self-hosted.
# =============================================================================

# --- Deployment mode ---------------------------------------------------------
# cloud | self-hosted
OXYQA_MODE=cloud

# --- GitHub App --------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Private key: path to the .pem, or the PEM contents inline (choose one)
GITHUB_APP_PRIVATE_KEY_PATH=./oxyqa-dev.private-key.pem
# GITHUB_APP_PRIVATE_KEY=

# --- Database (Postgres) -----------------------------------------------------
# Cloud: Supabase connection string. Self-hosted: local Postgres container.
DATABASE_URL=postgresql://oxyqa:oxyqa@localhost:5432/oxyqa

# --- Queue (Redis / BullMQ) --------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- LLM provider (provider-agnostic via Vercel AI SDK) ----------------------
# anthropic | openai | azure | bedrock | local
LLM_PROVIDER=anthropic
# sonnet is the working default; opus/fable reject AI-SDK sampling params until
# the temperature fix lands (see DECISIONS.md §7)
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AWS_REGION=

# --- Observability (all optional; unset = off, nothing leaves the deployment) --
# Error reporting (Sentry). Errors + stack + ids only — request bodies, LLM
# inputs/outputs, queue arguments and local variables are never collected.
SENTRY_DSN=
# Defaults to the Railway environment name, else "development".
# SENTRY_ENVIRONMENT=staging
# LLM tracing (Langfuse, self-hostable). Sends prompt content (diffs) and plan
# output to LANGFUSE_HOST. Both keys are required to turn it on.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to https://cloud.langfuse.com (EU). US cloud: https://us.cloud.langfuse.com
# LANGFUSE_HOST=

# --- Integrations (all optional / config-gated) ------------------------------
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# LINEAR_API_KEY=

# --- Billing (cloud only) ----------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Self-hosted entitlement -------------------------------------------------
# OXYQA_LICENSE_KEY=
