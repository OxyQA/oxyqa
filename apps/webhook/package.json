{
  "name": "@oxyqa/webhook",
  "version": "0.0.0",
  "private": true,
  "description": "Ingress service (Hono): verify signature, dedup by head SHA, enqueue job, return 200 fast (<1s).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@octokit/webhooks-methods": "^5.1.0",
    "@oxyqa/core": "workspace:*",
    "@oxyqa/db": "workspace:*",
    "hono": "^4.6.12",
    "tsx": "^4.19.2",
    "zod": "^3.23.8",
    "octokit": "^4.0.2"
  }
}
