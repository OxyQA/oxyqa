{
  "name": "@oxyqa/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Async processing (BullMQ): fetch diff, enrich context, build prompt, LLM call, format output, push integrations, record metrics.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "generate:sample": "tsx src/scripts/generate-sample.ts",
    "route:sample": "tsx src/scripts/route-sample.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.5",
    "@octokit/auth-app": "^7.1.5",
    "@oxyqa/core": "workspace:*",
    "@oxyqa/db": "workspace:*",
    "ai": "^4.0.18",
    "bullmq": "^5.28.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "octokit": "^4.0.2",
    "parse-diff": "^0.11.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  }
}
